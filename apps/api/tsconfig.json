{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@dtpm/config": ["../../packages/config/dist/index.d.ts"],
      "@dtpm/observability": ["../../packages/observability/dist/index.d.ts"],
      "@dtpm/testing": ["../../packages/testing/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.integration.test.ts",
    "src/**/*.e2e.test.ts"
  ]
}
