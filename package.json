{
  "name": "dtpm",
  "private": true,
  "version": "0.0.0",
  "description": "Montreal Immediate Delivery Marketplace — TypeScript monorepo skeleton (Phase 0)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --passWithNoTests",
    "start:api": "pnpm --filter @dtpm/api start",
    "start:worker": "pnpm --filter @dtpm/worker start",
    "start:sender-web": "pnpm --filter @dtpm/sender-web start",
    "start:admin-web": "pnpm --filter @dtpm/admin-web start",
    "start:driver-mobile": "pnpm --filter @dtpm/driver-mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
